    "topN = 25\n",
    "\n",
    "summer_sets = set(freq_summer.head(topN)['items'])\n",
    "winter_sets = set(freq_winter.head(topN)['items'])\n",
    "spring_sets = set(freq_spring.head(topN)['items'])\n",
    "fall_sets   = set(freq_fall.head(topN)['items'])\n",
    "\n",
    "def jaccard(a, b):\n",
    "    inter = len(a.intersection(b))\n",
    "    union = len(a.union(b))\n",
    "    return inter / union if union else 0\n",
    "\n",
    "season_sets = {\n",
    "    \"Summer\": summer_sets,\n",
    "    \"Winter\": winter_sets,\n",
    "    \"Spring\": spring_sets,\n",
    "    \"Fall\":   fall_sets\n",
    "}\n",
    "\n",
    "# Build DataFrame\n",
    "df = pd.DataFrame(\n",
    "    {s1: {s2: jaccard(season_sets[s1], season_sets[s2]) for s2 in season_sets}\n",
    "     for s1 in season_sets}\n",
    ")\n",
    "\n",
    "print(df.round(3))\n"
   ]
