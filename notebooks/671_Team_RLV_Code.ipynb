    "valid_rules = []\n",
    "\n",
    "for rule in association_results:\n",
    "    antecedents = list(rule.ordered_statistics[0].items_base)\n",
    "    consequents = list(rule.ordered_statistics[0].items_add)\n",
    "\n",
    "    # Skip empty-antecedent or self-referencing rules\n",
    "    if not antecedents or set(antecedents) & set(consequents):\n",
    "        continue\n",
    "\n",
    "    valid_rules.append(rule)\n",
    "\n",
    "# Show first 25 non-referencing\n",
    "for rule in valid_rules[:20]:\n",
    "    antecedents = list(rule.ordered_statistics[0].items_base)\n",
    "    consequents = list(rule.ordered_statistics[0].items_add)\n",
    "    \n",
    "    print(\"Rule:\", \" & \".join(antecedents), \"->\", \" & \".join(consequents))\n",
    "    print(\"Support:\", rule.support)\n",
    "    print(\"Confidence:\", rule.ordered_statistics[0].confidence)\n",
    "    print(\"Lift:\", rule.ordered_statistics[0].lift)\n",
    "    print(\"=====================================\")"
   ]
