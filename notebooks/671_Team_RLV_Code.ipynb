    "    \n",
    "    def count_pct(series, top_n=5):\n",
    "        counts = series.value_counts()\n",
    "        pct = (series.value_counts(normalize=True) * 100).round(2)\n",
    "        return [f\"{name}: {cnt} ({p}%)\" for name, cnt, p in zip(counts.index, counts.values, pct)]\n",
    "    \n",
    "    print(\"\\ntop genders:\")\n",
    "    print(\"\\n\".join(count_pct(sub['gender'])[:5]))\n",
    "    \n",
